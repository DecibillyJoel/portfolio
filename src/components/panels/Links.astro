---
import { links } from '../../data/links.js';
import Icon from '../Icon.astro';
---
<section class="links">
  <h2 class="heading">LINKS</h2>
  <p class="lede">Socials and profiles</p>
  <ul>
    {links.map((link) => (
      <li class="card">
        <Icon id={link.id} />
        <div class="meta">
          <span class="label">{link.label}</span>
          <a href={link.href} rel="me noopener"><span class="visually-hidden">{link.label}: </span>{link.value}</a>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .links { padding: 1.625rem 3.75rem 2rem; text-align: center; }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 56.25rem;
    text-align: left;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1rem 1.125rem;
  }
  .card :global(.icon) { color: var(--green); }
  .meta { min-width: 0; }
  .label { display: block; font-size: 0.6875rem; color: var(--muted); margin-bottom: 0.375rem; }
  .card a { font-size: 0.875rem; color: var(--green); text-decoration: none; }
  @media (hover: hover) {
    .card a:hover { text-decoration: underline; }
  }

  @media (max-width: 899px) {
    .links { padding: 1rem; }
    ul { grid-template-columns: 1fr; }
  }
</style>
