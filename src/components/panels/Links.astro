---
import { links } from '../../data/links.js';
import Icon from '../Icon.astro';
---
<section class="links">
  <h2 class="heading">LINKS</h2>
  <p class="lede">Socials and profiles</p>
  <ul>
    {links.map((link) => (
      <li class="card">
        <Icon id={link.id} />
        <div class="meta">
          <span class="label">{link.label}</span>
          <a href={link.href} rel="me noopener"><span class="visually-hidden">{link.label}: </span>{link.value}</a>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .links { padding: 2.4375rem 5.625rem 3rem; text-align: center; }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 84.375rem;
    text-align: left;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 1.3125rem;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.5rem 1.6875rem;
  }
  .card :global(.icon) { color: var(--green); }
  .meta { min-width: 0; }
  .label { display: block; font-size: 1rem; color: var(--muted); margin-bottom: 0.5625rem; }
  .card a { font-size: 1.3125rem; color: var(--green); text-decoration: none; }
  @media (hover: hover) {
    .card a:hover { text-decoration: underline; }
  }

  @media (max-width: 899px) {
    .links { padding: 1.5rem; }
    ul { grid-template-columns: 1fr; }
  }
</style>
