---
import { links } from '../../data/links.js';
import Icon from '../Icon.astro';
---
<section class="links">
  <h2>LINKS</h2>
  <ul>
    {links.map((link) => (
      <li class={link.pending ? 'card pending' : 'card'}>
        <Icon id={link.id} />
        <div class="meta">
          <span class="label">{link.label}</span>
          {link.href
            ? <a href={link.href} rel="me noopener"><span class="visually-hidden">{link.label}: </span>{link.value}</a>
            : <span class="value">{link.value}</span>}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .links { padding: 26px 60px 32px; text-align: center; }
  h2 {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--magenta);
    text-shadow: 0 0 12px var(--glow-magenta);
    margin: 0 0 22px;
  }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 900px;
    text-align: left;
  }
  .card {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 16px 18px;
  }
  .card :global(.icon) { color: var(--green); }
  .meta { min-width: 0; }
  .label { display: block; font-size: 11px; color: var(--muted); margin-bottom: 6px; }
  .card a { font-size: 14px; color: var(--green); text-decoration: none; }
  @media (hover: hover) {
    .card a:hover { text-decoration: underline; text-shadow: 0 0 6px var(--hover-glow-color); }
  }
  .card a:focus-visible { outline: 2px solid var(--magenta); outline-offset: 2px; }
  .value { font-size: 14px; color: var(--green); }
  .pending .value { color: var(--muted); }

  @media (max-width: 899px) {
    .links { padding: 16px; }
    h2 { font-size: 18px; margin-bottom: 16px; }
    ul { grid-template-columns: 1fr; }
  }
</style>
