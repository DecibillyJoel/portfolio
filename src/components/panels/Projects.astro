---
import Player from '../Player.astro';
import { projects } from '../../data/projects.js';
---
<section class="projects">
  <div class="sub-tabs" role="tablist" aria-label="Projects">
    {projects.map((project) => (
      <a
        role="tab"
        id={`subtab-${project.id}`}
        data-sub-tab-target={project.id}
        data-hash={project.hash}
        href={`#${project.hash}`}
        aria-controls={`project-${project.id}`}
        data-active="false"
        aria-selected="false"
      >{project.label}</a>
    ))}
  </div>

  {projects.map((project) => (
    <div
      class="project"
      id={`project-${project.id}`}
      data-project={project.id}
      role="tabpanel"
      aria-labelledby={`subtab-${project.id}`}
      hidden
    >
      <h2>{project.title}</h2>
      {project.tagline && <p class="tagline">{project.tagline}</p>}
      <p class="blurb blurb-wide">{project.blurbWide}</p>
      {project.blurbNarrow && <p class="blurb blurb-narrow">{project.blurbNarrow}</p>}
      {project.href && (
        <a
          class="project-link"
          href={project.href}
          target="_blank"
          rel="noopener"
          tabindex="0"
        >{project.linkLabel}</a>
      )}
      {project.embedKind === 'player' && <Player />}
      {project.embedKind === 'iframe' && (
        <div class="game">
          <iframe
            data-embed
            data-embed-kind="iframe"
            data-loaded="false"
            data-src={project.embed}
            width="800"
            height="450"
            frameborder="0"
            title={project.embedTitle}
          ></iframe>
        </div>
      )}
    </div>
  ))}

  <p class="empty" data-project-empty>Select a project above.</p>
</section>

<style>
  .sub-tabs { display: flex; flex-wrap: wrap; gap: 14px; padding: 12px 22px; border-bottom: 1px solid #142a18; }
  .sub-tabs a {
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--magenta);
    border: 1px solid #7a1a66;
    padding: 5px 12px;
    cursor: pointer;
    text-decoration: none;
    text-shadow: 0 0 6px #ff2fd088;
  }
  .sub-tabs a[data-active='true']::before { content: '> '; }
  @media (hover: hover) {
    .sub-tabs a:hover {
      border-color: #b62a97;
      text-shadow: 0 0 10px #ff2fd0aa;
    }
  }
  .project[hidden] { display: none; }
  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 18px;
  }
  h2 {
    font-size: 26px;
    font-weight: 800;
    color: var(--magenta);
    text-shadow: 0 0 12px #ff2fd088;
    margin: 0 0 6px;
  }
  .tagline { font-size: 13px; color: var(--muted); margin: 0 0 12px; }
  .blurb { font-size: 12px; line-height: 1.5; max-width: 520px; margin: 0 0 14px; }
  .blurb-narrow { display: none; }
  .project-link { font-size: 12px; color: var(--green); margin: 0 0 14px; }
  @media (hover: hover) {
    .project-link:hover {
      text-decoration: underline;
      text-shadow: var(--hover-glow);
    }
  }
  .empty { padding: 48px 22px; text-align: center; color: var(--muted); font-size: 13px; }
  .game {
    border: 1px solid var(--border);
    background: #060906;
    padding: 8px;
    display: inline-block;
    max-width: 100%;
  }
  .game iframe {
    display: block;
    width: 760px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  @media (max-width: 899px) {
    .project { padding: 14px 16px; }
    h2 { font-size: 18px; }
    .tagline { font-size: 11px; margin-bottom: 10px; }
    .blurb-wide { display: none; }
    .blurb-narrow { display: block; font-size: 11px; line-height: 1.5; margin: 0 0 12px; }
    .game { padding: 4px; }
  }
</style>
