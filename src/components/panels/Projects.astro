---
import Player from '../Player.astro';
import SoundCloud from '../SoundCloud.astro';
import { projects } from '../../data/projects.js';
---
<section class="projects">
  <div class="sub-tabs" role="tablist" aria-label="Projects" data-rows>
    {projects.map((project) => (
      <a
        role="tab"
        id={`subtab-${project.id}`}
        data-sub-tab-target={project.id}
        data-hash={project.hash}
        href={`#${project.hash}`}
        aria-controls={`project-${project.id}`}
        aria-selected="false"
      ><span class="prompt" aria-hidden="true">{'> '}</span>{project.label}</a>
    ))}
  </div>

  <div class="projects-scroll">
    {projects.map((project) => (
      <div
        class="project"
        id={`project-${project.id}`}
        data-project={project.id}
        role="tabpanel"
        aria-labelledby={`subtab-${project.id}`}
        tabindex="-1"
        hidden
      >
        <h2 class="heading heading--tight">{project.title}</h2>
        {project.tagline && <p class="tagline">{project.tagline}</p>}
        <p class="lede">{project.blurb}</p>
        {project.href && (
          <a
            class="project-link ext-link"
            href={project.href}
            target="_blank"
            rel="noopener"
          >{project.linkLabel}<span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> — opens in a new tab</span></a>
        )}
        {project.embedKind === 'player' && <Player />}
        {project.embedKind === 'soundcloud' && <SoundCloud />}
        {project.embedKind === 'iframe' && (
          <div class="game embed-box">
            <iframe
              data-embed
              data-embed-kind="iframe"
              data-loaded="false"
              data-src={project.embed}
              sandbox="allow-scripts allow-same-origin allow-popups"
              title={project.embedTitle}
            ></iframe>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  /* The panel is a fixed frame. Only .projects-scroll moves, so the sub-tab bar
     stays above the scroll area instead of inside it. */
  .projects {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .sub-tabs { position: relative; display: flex; flex-wrap: wrap; flex: 0 0 auto; gap: 1.3125rem; padding: 0.5rem 2.0625rem; border-bottom: 1px solid var(--border); background: var(--bg); }
  /* The bar folds away on a project route. It carries a flex display of its own,
     which would beat the hidden attribute, so it needs a rule of its own. */
  .sub-tabs[hidden] { display: none; }
  .projects-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .projects-scroll:focus-visible { outline-offset: -2px; }
  .sub-tabs a {
    background: none;
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--green);
    border: 0;
    padding: 0.5rem 0;
    cursor: pointer;
    text-decoration: none;
    position: relative;
  }
  /* The same short hairline the tab list above wears, centred in the gap between
     two sub-tabs, so both bars read as one list of separate items. The last item
     is found by type: a measured bar appends its row rules as children. */
  .sub-tabs a:not(:last-of-type)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -0.65625rem;
    width: 1px;
    height: 1em;
    margin-top: -0.5em;
    background: var(--border);
  }
  .sub-tabs a[data-row-end]::after { display: none; }
  /* The prompt marks the selected sub-tab and stays out of its accessible name.
     The sub-tabs take the same colour and the same hover underline as the tabs
     above them, so every clickable on the page reads as one group. */
  .sub-tabs .prompt { display: none; }
  .sub-tabs a[aria-selected='true'] .prompt { display: inline; }
  .sub-tabs a:focus-visible { text-decoration: underline; }
  @media (hover: hover) {
    .sub-tabs a:hover { text-decoration: underline; }
  }
  .project[hidden] { display: none; }
  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.6875rem;
  }
  .tagline { font-size: 1.25rem; color: var(--muted); margin: 0 0 1.125rem; }
  .project-link { font-size: 1.125rem; color: var(--green); margin: 0 0 1.3125rem; }
  /* The frame comes from .embed-box. The game keeps its own shape: a 16 by 9
     box that fills the panel until it reaches this width. */
  .game { --game-width: 71.25rem; }
  .game iframe {
    width: var(--game-width);
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  /* The SoundCloud widget reflows to its width, so its frame only needs a
     ceiling for narrow screens. The script sets the width and the height. */
  .soundcloud iframe { max-width: 100%; }

  @media (max-width: 1149px) {
    /* A wrapped line of sub-tabs costs one line of text, not a row of air, so
       the row gap shrinks and the side padding matches the project body. */
    .sub-tabs {
      gap: 0.5rem 1.3125rem;
      padding: 0.375rem 1.25rem;
    }
    /* The tabs shrink below the wide layout, so the sub-tabs shrink by the same
       factor and keep their step down the hierarchy. The padding keeps the 24px
       pointer target that 14px text on its own would not reach. */
    .sub-tabs a { padding: 0.375rem 0; font-size: 0.875rem; }
    /* A wrapped row of sub-tabs takes the air the header itself uses between its
       own rows, so a second row costs a line of text rather than a row of air. */
    .sub-tabs[data-wrapped] { gap: var(--wrap-gap) 1.3125rem; }
    .sub-tabs[data-wrapped] a { padding: 0.125rem 0; }
    .project { padding: 1rem 1.25rem; }
    .tagline { font-size: 1.125rem; margin-bottom: 0.875rem; }
  }
</style>
