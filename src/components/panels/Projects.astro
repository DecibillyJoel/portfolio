---
import Player from '../Player.astro';
import { projects } from '../../data/projects.js';
---
<section class="projects">
  <div class="sub-tabs" role="tablist" aria-label="Projects">
    {projects.map((project) => (
      <a
        role="tab"
        id={`subtab-${project.id}`}
        data-sub-tab-target={project.id}
        data-hash={project.hash}
        href={`#${project.hash}`}
        aria-controls={`project-${project.id}`}
        aria-selected="false"
      ><span class="prompt" aria-hidden="true">{'> '}</span>{project.label}</a>
    ))}
  </div>

  <div class="projects-scroll" tabindex="0">
    {projects.map((project) => (
      <div
        class="project"
        id={`project-${project.id}`}
        data-project={project.id}
        role="tabpanel"
        aria-labelledby={`subtab-${project.id}`}
        hidden
      >
        <h2 class="heading heading--tight">{project.title}</h2>
        {project.tagline && <p class="tagline">{project.tagline}</p>}
        <p class="lede">{project.blurb}</p>
        {project.href && (
          <a
            class="project-link"
            href={project.href}
            target="_blank"
            rel="noopener"
          >{project.linkLabel}</a>
        )}
        {project.embedKind === 'player' && <Player />}
        {project.embedKind === 'iframe' && (
          <div class="game embed-box">
            <iframe
              data-embed
              data-embed-kind="iframe"
              data-loaded="false"
              data-src={project.embed}
              title={project.embedTitle}
            ></iframe>
          </div>
        )}
      </div>
    ))}

    <p class="empty" data-project-empty>Select a project above.</p>
  </div>
</section>

<style>
  /* The panel is a fixed frame. Only .projects-scroll moves, so the sub-tab bar
     stays above the scroll area instead of inside it. */
  .projects {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .sub-tabs { display: flex; flex-wrap: wrap; flex: 0 0 auto; gap: 0.875rem; padding: var(--subtab-pad-y) var(--bar-pad-x); border-bottom: 1px solid var(--border); background: var(--bg); }
  .projects-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .projects-scroll:focus-visible { outline-offset: -2px; }
  .sub-tabs a {
    background: none;
    font: inherit;
    font-size: var(--fs-subtab);
    line-height: 1.5;
    color: var(--muted);
    border: 0;
    padding: 0.3125rem 0;
    cursor: pointer;
    text-decoration: none;
  }
  /* The prompt marks the selected sub-tab and stays out of its accessible name. */
  .sub-tabs .prompt { display: none; }
  .sub-tabs a[aria-selected='true'] .prompt { display: inline; }
  /* The same colour ramp as the bar above it. */
  .sub-tabs a[aria-selected='true'] { color: var(--green); }
  @media (hover: hover) {
    .sub-tabs a:hover { color: var(--hover); }
    .sub-tabs a[aria-selected='true']:hover { color: var(--green); }
  }
  .project[hidden] { display: none; }
  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.125rem;
  }
  .tagline { font-size: 0.8125rem; color: var(--muted); margin: 0 0 0.75rem; }
  .project-link { font-size: 0.75rem; color: var(--green); margin: 0 0 0.875rem; }
  @media (hover: hover) {
    .project-link:hover {
      text-decoration: underline;
    }
  }
  .empty { padding: 3rem 1.375rem; text-align: center; color: var(--muted); font-size: 0.8125rem; }
  /* The frame comes from .embed-box. The game keeps its own shape: a 16 by 9
     box that fills the panel until it reaches this width. */
  .game { --game-width: 47.5rem; }
  .game iframe {
    width: var(--game-width);
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 899px) {
    /* The sub-tab labels are long, so they take one step down on a phone to
       stop the bar from stacking into three or four rows. */
    .sub-tabs a { font-size: 0.6875rem; }
    .project { padding: 0.875rem 1rem; }
    .tagline { font-size: 0.6875rem; margin-bottom: 0.625rem; }
  }
</style>
