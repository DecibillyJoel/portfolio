---
import Player from '../Player.astro';
import { projects } from '../../data/projects.js';
---
<section class="projects">
  <div class="sub-tabs" role="tablist" aria-label="Projects">
    {projects.map((project) => (
      <a
        role="tab"
        id={`subtab-${project.id}`}
        data-sub-tab-target={project.id}
        data-hash={project.hash}
        href={`#${project.hash}`}
        aria-controls={`project-${project.id}`}
        aria-selected="false"
      ><span class="prompt" aria-hidden="true">{'> '}</span>{project.label}</a>
    ))}
  </div>

  <div class="projects-scroll" tabindex="0">
    {projects.map((project) => (
      <div
        class="project"
        id={`project-${project.id}`}
        data-project={project.id}
        role="tabpanel"
        aria-labelledby={`subtab-${project.id}`}
        hidden
      >
        <h2 class="heading heading--tight">{project.title}</h2>
        {project.tagline && <p class="tagline">{project.tagline}</p>}
        <p class="lede">{project.blurb}</p>
        {project.href && (
          <a
            class="project-link"
            href={project.href}
            target="_blank"
            rel="noopener"
          >{project.linkLabel}</a>
        )}
        {project.embedKind === 'player' && <Player />}
        {project.embedKind === 'iframe' && (
          <div class="game embed-box">
            <iframe
              data-embed
              data-embed-kind="iframe"
              data-loaded="false"
              data-src={project.embed}
              title={project.embedTitle}
            ></iframe>
          </div>
        )}
      </div>
    ))}

    <p class="empty" data-project-empty>Select a project above.</p>
  </div>
</section>

<style>
  /* The panel is a fixed frame. Only .projects-scroll moves, so the sub-tab bar
     stays above the scroll area instead of inside it. */
  .projects {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }
  .sub-tabs { display: flex; flex-wrap: wrap; flex: 0 0 auto; gap: 14px; padding: 12px 22px; border-bottom: 1px solid var(--border); background: var(--bg); }
  .projects-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .projects-scroll:focus-visible { outline-offset: -2px; }
  .sub-tabs a {
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--magenta);
    border: 1px solid var(--magenta);
    padding: 5px 12px;
    cursor: pointer;
    text-decoration: none;
    text-shadow: 0 0 6px var(--glow-magenta);
  }
  /* The prompt marks the selected sub-tab and stays out of its accessible name. */
  .sub-tabs .prompt { display: none; }
  .sub-tabs a[aria-selected='true'] .prompt { display: inline; }
  @media (hover: hover) {
    .sub-tabs a:hover {
      border-color: var(--magenta);
      text-shadow: 0 0 10px var(--glow-magenta-soft);
    }
  }
  .project[hidden] { display: none; }
  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 18px;
  }
  .tagline { font-size: 13px; color: var(--muted); margin: 0 0 12px; }
  .project-link { font-size: 12px; color: var(--green); margin: 0 0 14px; }
  @media (hover: hover) {
    .project-link:hover {
      text-decoration: underline;
      text-shadow: 0 0 6px var(--hover-glow-color);
    }
  }
  .empty { padding: 48px 22px; text-align: center; color: var(--muted); font-size: 13px; }
  /* The frame comes from .embed-box. The game keeps its own shape: a 16 by 9
     box that fills the panel until it reaches this width. */
  .game { --game-width: 760px; }
  .game iframe {
    width: var(--game-width);
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 899px) {
    .project { padding: 14px 16px; }
    .tagline { font-size: 11px; margin-bottom: 10px; }
  }
</style>
