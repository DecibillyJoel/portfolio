---
import { certifications } from '../../data/certifications.js';
---
<section class="certs">
  <h2 class="heading">CERTIFICATIONS</h2>
  <p class="lede">
    These are all the certifications I've earned so far. The credential links are omitted from here, but you can find them on my LinkedIn page.
  </p>
  <ul>
    {certifications.map((cert) => (
      <li class="cert">
        <h3>
          <a href={cert.href} target="_blank" rel="noopener noreferrer">
            {cert.name}
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden"> — official description, opens in a new tab</span>
          </a>
        </h3>
        <p class="meta">
          <span class="issuer">{cert.issuer}</span>
          <span class="sep" aria-hidden="true">//</span>
          <span class="dates">{cert.dates}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .certs {
    padding: 1.625rem 3.75rem 2rem;
    text-align: center;
  }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
    max-width: 53.75rem;
    text-align: left;
  }
  .cert {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.875rem 1rem;
  }
  h3 {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0;
  }
  h3 a {
    color: var(--green);
    text-decoration: none;
  }
  .arrow {
    color: var(--muted);
    margin-left: 0.25rem;
  }
  @media (hover: hover) {
    h3 a:hover {
      text-decoration: underline;
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin: 0;
  }
  .sep { color: var(--dim); }

  @media (max-width: 899px) {
    .certs { padding: 1rem; }
    ul { grid-template-columns: 1fr; gap: 0.625rem; }
    .cert { padding: 0.75rem 0.875rem; }
    h3 { font-size: 0.75rem; }
  }
</style>
