---
import { certifications } from '../../data/certifications.js';
---
<section class="certs">
  <h2 class="heading">CERTIFICATIONS</h2>
  <p class="lede">
    These are all the certifications I've earned so far. The credential links are omitted from here, but you can find them on my LinkedIn page.
  </p>
  <ul>
    {certifications.map((cert) => (
      <li class="cert">
        <h3>
          <a class="ext-link" href={cert.href} target="_blank" rel="noopener noreferrer">
            {cert.name}
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden"> — official description, opens in a new tab</span>
          </a>
        </h3>
        <p class="meta">
          <span class="issuer">{cert.issuer}</span>
          <span class="sep" aria-hidden="true">//</span>
          <span class="dates">{cert.dates}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Every view wears the same panel measurements, so the columns of one view
     line up with the columns of the next. */
  .certs {
    padding: var(--panel-pad-top) var(--panel-pad-x) var(--panel-pad-bottom);
    text-align: center;
  }
  ul {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--panel-grid-gap);
    max-width: var(--panel-grid-max);
    text-align: left;
  }
  .cert {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9375rem;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 1.3125rem 1.5rem;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0;
  }
  h3 a {
    color: var(--green);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin: 0;
  }
  .sep { color: var(--dim); }

  @media (max-width: 1149px) {
    ul { grid-template-columns: minmax(0, 1fr); }
    .cert { padding: 1.125rem 1.25rem; }
    h3 { font-size: 1.125rem; }
  }
</style>
