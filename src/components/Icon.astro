---
import { icons } from '../data/icons.js';
const { id } = Astro.props;
const path = icons[id];
---
{path && (
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d={path} />
  </svg>
)}

<style>
  .icon {
    width: 18px;
    height: 18px;
    flex: none;
    fill: currentColor;
  }
</style>
