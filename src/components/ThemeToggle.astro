---
// One control, three states. Auto follows the operating system. The two pinned
// states override it. Each state draws its own icon, and the stylesheet picks
// the icon from the attribute on the root element, so the icons are right
// before any script runs.
---
<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Theme: auto. Activate to change."
  title="Theme: auto"
>
  <svg data-theme-icon="auto" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
  </svg>
  <svg data-theme-icon="light" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <path
      d="M12 1.8v2.6M12 19.6v2.6M1.8 12h2.6M19.6 12h2.6M4.9 4.9l1.9 1.9M17.2 17.2l1.9 1.9M19.1 4.9l-1.9 1.9M6.8 17.2l-1.9 1.9"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <svg data-theme-icon="dark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5 8.6 8.6 0 1 0 20.5 14.2z" fill="currentColor"></path>
  </svg>
</button>

<style>
  /* A browser without light-dark() cannot switch themes, so it gets no
     control. The rule is hidden rather than removed, and the button carries
     the same box as the status badge. */
  .theme-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 4px 5px;
    color: var(--green);
    background: none;
    font: inherit;
    border: 1px solid var(--border);
    line-height: 0;
    cursor: pointer;
  }

  @supports (color: light-dark(#000, #fff)) {
    .theme-toggle { display: inline-flex; }
  }

  .theme-toggle svg { display: none; }
  .theme-toggle svg[data-theme-icon='auto'] { display: block; }

  :global(html[data-theme-pref='light']) .theme-toggle svg[data-theme-icon='auto'],
  :global(html[data-theme-pref='dark']) .theme-toggle svg[data-theme-icon='auto'] { display: none; }
  :global(html[data-theme-pref='light']) .theme-toggle svg[data-theme-icon='light'] { display: block; }
  :global(html[data-theme-pref='dark']) .theme-toggle svg[data-theme-icon='dark'] { display: block; }
</style>
