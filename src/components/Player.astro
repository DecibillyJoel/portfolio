---
import { player } from '../data/player.js';

const base = `https://live365.com/embeds/v1/player/${player.station}`;
const params = 'm=dark&c=aac';
const { xl } = player.sizes;
---
<div class="player embed-box">
  <iframe
    data-embed
    data-embed-kind="player"
    data-loaded="false"
    data-src-xl={`${base}?s=xl&${params}`}
    data-src-sm={`${base}?s=sm&${params}`}
    width={xl.width}
    height={xl.height}
    title="Maximum Slappage player"
  ></iframe>
</div>
