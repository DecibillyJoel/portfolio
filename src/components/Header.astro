---
import TabBar from './TabBar.astro';
import ThemeToggle from './ThemeToggle.astro';

// The 404 document shows the same brand row without the tab bar and the
// station badge, so one header serves both documents.
const { tabs = true, status = true } = Astro.props;
const slim = !tabs && !status;
---
<header class="site-header" data-slim={slim ? 'true' : undefined}>
  <div class="brand">
    <img class="monogram" src="/monogram.webp" alt="" width="30" height="30" />
    <h1 class="brand-name">@JoeOfSomeTrades</h1>
  </div>
  {tabs && <span class="divider" aria-hidden="true"></span>}
  {tabs && <TabBar />}
  {
    status && (
      <span class="on-air" data-on-air data-state="off" role="status"
        ><span aria-hidden="true">[</span> <span data-on-air-text>OFF AIR</span> <span aria-hidden="true">]</span></span
      >
    )
  }
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem var(--bar-pad-x);
    padding: var(--header-pad-y) var(--bar-pad-x);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 0.625rem; }
  .monogram {
    width: 1.875rem; height: 1.875rem;
    display: block;
    border: 1px solid var(--green);
    background: var(--header);
    object-fit: cover;
  }
  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text);
    margin: 0;
  }
  .divider { width: 1px; height: 1.375rem; background: var(--border); }
  .on-air {
    margin-left: auto;
    background: none;
    font: inherit;
    font-size: 0.6875rem;
    color: var(--muted);
    border: 1px solid var(--dim);
    padding: 0.25rem 0.6875rem;
    text-decoration: none;
  }
  .on-air[data-state='on-air'],
  .on-air[data-state='running'] { color: var(--green); }

  /* The badge takes the free space. Without it, the control does. */
  :global(.theme-toggle) { margin-left: 0.5rem; }
  .site-header[data-slim] :global(.theme-toggle) { margin-left: auto; }

  @media (max-width: 899px) {
    .site-header { padding: 0.625rem 1rem; gap: 0.625rem 0.875rem; }
    .divider { display: none; }
  }
</style>
