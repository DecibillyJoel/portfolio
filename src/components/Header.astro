---
import TabBar from './TabBar.astro';
import ThemeToggle from './ThemeToggle.astro';

// The 404 document shows the same brand row without the tab bar and the
// station badge, so one header serves both documents.
const { tabs = true, status = true } = Astro.props;
const slim = !tabs && !status;
---
<header class="site-header" data-slim={slim ? 'true' : undefined}>
  <div class="brand">
    <img class="monogram" src="/monogram.webp" alt="" width="30" height="30" />
    <h1 class="brand-name">@JoeOfSomeTrades</h1>
  </div>
  {tabs && <span class="divider" aria-hidden="true"></span>}
  {tabs && <TabBar />}
  {
    status && (
      <span class="on-air" data-on-air data-state="off" role="status"
        ><span aria-hidden="true">[</span> <span data-on-air-text>OFF AIR</span> <span aria-hidden="true">]</span></span
      >
    )
  }
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 16px 22px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .monogram {
    width: 30px; height: 30px;
    display: block;
    border: 1px solid var(--green);
    background: var(--header);
    object-fit: cover;
  }
  .brand-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--text);
    margin: 0;
  }
  .divider { width: 1px; height: 22px; background: var(--border); }
  .on-air {
    margin-left: auto;
    background: none;
    font: inherit;
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--dim);
    padding: 4px 11px;
    text-decoration: none;
  }
  .on-air[data-state='on-air'],
  .on-air[data-state='running'] { color: var(--green); text-shadow: 0 0 8px var(--glow-green); }

  /* The badge takes the free space. Without it, the control does. */
  :global(.theme-toggle) { margin-left: 8px; }
  .site-header[data-slim] :global(.theme-toggle) { margin-left: auto; }

  @media (max-width: 899px) {
    .site-header { padding: 10px 16px; gap: 10px 14px; }
    .divider { display: none; }
  }
</style>
