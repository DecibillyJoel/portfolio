---
import TabBar from './TabBar.astro';
---
<header class="site-header">
  <div class="brand">
    <img class="monogram" src="/favicon.png" alt="" width="30" height="30" />
    <h1 class="brand-name">@JoeOfSomeTrades</h1>
  </div>
  <span class="divider" aria-hidden="true"></span>
  <TabBar />
  <span class="on-air" data-on-air data-state="off" role="status">[ OFF AIR ]</span>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 16px 22px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .monogram {
    width: 30px; height: 30px;
    display: block;
    border: 1px solid var(--green);
    background: #0d1a10;
    object-fit: cover;
  }
  .brand-name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #c9ffc2;
    margin: 0;
  }
  .divider { width: 1px; height: 22px; background: var(--border); }
  .on-air {
    margin-left: auto;
    background: none;
    font: inherit;
    font-size: 11px;
    color: var(--muted);
    border: 1px solid #2c5a33;
    padding: 4px 11px;
    text-decoration: none;
  }
  .on-air[data-state='on-air'],
  .on-air[data-state='running'] { color: var(--green); text-shadow: 0 0 8px #39ff1488; }

  @media (max-width: 899px) {
    .site-header { padding: 10px 16px; gap: 10px 14px; }
    .divider { display: none; }
  }
</style>
