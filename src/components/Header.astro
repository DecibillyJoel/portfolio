---
import TabBar from './TabBar.astro';
import ThemeToggle from './ThemeToggle.astro';
import { views } from '../data/routes.js';

// The 404 document shows the same brand row without the tab bar and the
// station badge, so one header serves both documents.
const { tabs = true, status = true } = Astro.props;
const slim = !tabs && !status;

// The Links view sits with the handle instead of in the tab list.
const links = views.find((view) => view.id === 'links');
---
<header class="site-header" data-slim={slim ? 'true' : undefined}>
  <div class="brand">
    <img class="monogram" src="/monogram.webp" alt="" width="30" height="30" />
    <div class="brand-lockup">
      <h1 class="brand-name">@JoeOfSomeTrades</h1>
      {
        tabs && (
          <a
            class="brand-link"
            data-view={links.id}
            data-hash={links.hash}
            href={`#${links.hash}`}
          >{links.label}</a>
        )
      }
    </div>
  </div>
  {tabs && <span class="divider" aria-hidden="true" />}
  {tabs && <TabBar />}
  {
    status && (
      <span class="on-air" data-on-air data-state="off" role="status"
        ><span aria-hidden="true">[</span> <span data-on-air-text>OFF AIR</span> <span aria-hidden="true">]</span></span
      >
    )
  }
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem 2.0625rem;
    padding: 1.125rem 2.0625rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  /* The handle starts level with the top of the helmet, and the Links view
     sits under the handle rather than beside it in the tab list. */
  .brand { display: flex; align-items: flex-start; gap: 0.9375rem; }
  .brand-lockup { display: flex; flex-direction: column; gap: 0.1875rem; }
  .monogram {
    width: 2.8125rem; height: 2.8125rem;
    display: block;
    border: 1px solid var(--green);
    background: var(--header);
    object-fit: cover;
  }
  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.03em;
    color: var(--text);
    margin: 0;
  }
  .brand-link {
    font-size: 1.125rem;
    color: var(--muted);
    text-decoration: none;
  }
  .brand-link[aria-current='true'] { color: var(--green); }
  /* One hairline between the handle column and the tab list. */
  .divider {
    width: 1px;
    height: 2.8125rem;
    flex: none;
    background: var(--border);
  }
  .on-air {
    margin-left: auto;
    background: none;
    font: inherit;
    font-size: 1rem;
    color: var(--muted);
    border: 1px solid var(--dim);
    padding: 0.375rem 1rem;
    text-decoration: none;
  }
  .on-air[data-state='on-air'],
  .on-air[data-state='running'] { color: var(--green); }

  /* The badge takes the free space. Without it, the control does. */
  :global(.theme-toggle) { margin-left: 0.75rem; }
  .site-header[data-slim] :global(.theme-toggle) { margin-left: auto; }

  @media (hover: hover) {
    .brand-link:hover { color: var(--hover); }
    .brand-link[aria-current='true']:hover { color: var(--green); }
  }

  @media (max-width: 899px) {
    .site-header { padding: 0.9375rem 1.5rem; gap: 0.9375rem 1.3125rem; }
    /* A hairline between two stacked rows reads as noise. */
    .divider { display: none; }
  }
</style>
