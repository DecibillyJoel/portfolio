---
import TabBar from './TabBar.astro';
---
<header class="site-header">
  <div class="brand">
    <img class="monogram" src="/favicon.png" alt="" width="30" height="30" />
    <strong>@JoeOfSomeTrades</strong>
  </div>
  <span class="divider" aria-hidden="true"></span>
  <TabBar />
  <button type="button" class="on-air" data-on-air data-state="off" data-clickable="false" disabled>[ OFF AIR ]</button>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 16px 22px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .monogram {
    width: 30px; height: 30px;
    display: block;
    border: 1px solid var(--green);
    background: #0d1a10;
    object-fit: cover;
  }
  strong { font-size: 15px; letter-spacing: 0.5px; color: #c9ffc2; }
  .divider { width: 1px; height: 22px; background: var(--border); }
  .on-air {
    margin-left: auto;
    background: none;
    font: inherit;
    font-size: 11px;
    color: var(--muted);
    border: 1px solid #2c5a33;
    padding: 4px 11px;
  }
  .on-air:disabled { opacity: 1; }
  .on-air[data-state='on-air'],
  .on-air[data-state='playing'] { color: var(--green); text-shadow: 0 0 8px #39ff1488; }
  .on-air[data-clickable='true'] { cursor: pointer; }
  .on-air[data-clickable='true']:hover,
  .on-air[data-clickable='true']:focus-visible {
    border-color: var(--green);
    color: var(--green);
  }

  @media (max-width: 899px) {
    .site-header { padding: 10px 16px; gap: 10px 14px; }
    .divider { display: none; }
  }
</style>
