---
import { routes } from '../data/routes.js';

// The standalone 404 page is a different document, so its links need the
// absolute form. The in-page view sits at `/` and takes the bare form, which
// the browser treats as a same-document navigation.
const { prefix = '/' } = Astro.props;
---

<div class="not-found">
  <h2 class="heading">404 - Dead Air</h2>
  <p>Signal lost. Tune in to an active frequency below:</p>
  <ul class="routes">
    {
      routes.map((route) => (
        <li>
          <a href={`${prefix}#${route.hash}`}><span class="prompt" aria-hidden="true">{'> '}</span>{route.label}</a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .not-found {
    padding: 4.5rem 2.0625rem;
    max-width: 67.5rem;
  }
  p {
    color: var(--muted);
    margin: 0 0 2.0625rem;
  }
  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9375rem 2.0625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .routes a {
    color: var(--green);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.1875rem;
  }
  /* The prompt is decoration, so it stays out of the link name. */
  .routes .prompt {
    color: var(--muted);
  }
  @media (hover: hover) {
    .routes a:hover {
      border-bottom-color: var(--green);
    }
  }
  @media (max-width: 1149px) {
    .not-found {
      padding: 2.25rem 1.25rem;
    }
  }
</style>
