---
import { tabs } from '../data/routes.js';
---
<nav class="tab-bar" role="tablist" aria-label="Sections">
  {tabs.map((tab, index) => (
    <a
      role="tab"
      id={`tab-${tab.id}`}
      data-tab-target={tab.id}
      data-hash={tab.hash}
      href={`#${tab.hash}`}
      aria-controls={`panel-${tab.id}`}
      aria-selected={index === 0 ? 'true' : 'false'}
    ><span class="prompt" aria-hidden="true">{'> '}</span>{tab.label}</a>
  ))}
</nav>

<style>
  .tab-bar {
    display: flex;
    gap: 1.375rem;
  }
  a {
    background: none;
    border: 0;
    padding: 0.375rem 0;
    font: inherit;
    font-size: var(--fs-tab);
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
  }
  /* One colour ramp for every bar: selected is the brightest, hover sits one
     step below it, and everything else is the dimmest. */
  a[aria-selected='true'] {
    color: var(--green);
  }
  /* The prompt marks the selected tab. It is hidden from assistive tech, so
     the tab is announced by its label alone. */
  .prompt { display: none; }
  a[aria-selected='true'] .prompt { display: inline; }
  a:focus-visible { outline: 2px solid var(--magenta); outline-offset: 2px; }

  @media (hover: hover) {
    a:hover { color: var(--hover); }
    a[aria-selected='true']:hover { color: var(--green); }
  }

  @media (max-width: 899px) {
    /* Four tabs on one line need a type size too small to read, and letting
       them shrink wraps the words inside the tabs. Two tidy rows instead. */
    .tab-bar { flex: 1 1 100%; order: 9; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 0.875rem; }
    a { font-size: 0.6875rem; }
  }
</style>
