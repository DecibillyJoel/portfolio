---
import { tabs } from '../data/routes.js';
---
<nav class="tab-bar" role="tablist" aria-label="Sections">
  {tabs.map((tab, index) => (
    <a
      role="tab"
      id={`tab-${tab.id}`}
      data-tab-target={tab.id}
      data-hash={tab.hash}
      href={`#${tab.hash}`}
      aria-controls={`panel-${tab.id}`}
      aria-selected={index === 0 ? 'true' : 'false'}
    ><span class="prompt" aria-hidden="true">{'> '}</span>{tab.label}</a>
  ))}
</nav>

<style>
  .tab-bar {
    display: flex;
    gap: 22px;
  }
  a {
    background: none;
    border: 0;
    padding: 6px 0;
    font: inherit;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
  }
  a[aria-selected='true'] {
    color: var(--green);
    text-shadow: 0 0 8px var(--glow-green);
  }
  /* The prompt marks the selected tab. It is hidden from assistive tech, so
     the tab is announced by its label alone. */
  .prompt { display: none; }
  a[aria-selected='true'] .prompt { display: inline; }
  a:focus-visible { outline: 2px solid var(--magenta); outline-offset: 2px; }

  @media (hover: hover) {
    a:hover {
      color: var(--hover);
      text-shadow: 0 0 6px var(--hover-glow-color);
    }
    a[aria-selected='true']:hover { color: var(--green); text-shadow: 0 0 12px var(--glow-green-strong); }
  }

  @media (max-width: 899px) {
    .tab-bar { flex: 1 1 100%; order: 9; gap: 14px; }
    a { font-size: 11px; }
  }
</style>
