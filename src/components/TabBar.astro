---
import { tabs } from '../data/routes.js';
---
<nav class="tab-bar" role="tablist" aria-label="Sections">
  {tabs.map((tab, index) => (
    <a
      role="tab"
      id={`tab-${tab.id}`}
      data-tab-target={tab.id}
      data-hash={tab.hash}
      href={`#${tab.hash}`}
      aria-controls={`panel-${tab.id}`}
      aria-selected={index === 0 ? 'true' : 'false'}
    ><span class="prompt" aria-hidden="true">{'> '}</span>{tab.label}</a>
  ))}
</nav>

<style>
  .tab-bar {
    display: flex;
    gap: 2.0625rem;
  }
  a {
    background: none;
    border: 0;
    padding: 0.5625rem 0;
    font: inherit;
    font-size: 1.125rem;
    color: var(--green);
    text-decoration: none;
    cursor: pointer;
  }
  /* Every clickable on the site wears one colour: the link colour. The prompt
     marks the selected tab, so selection needs no second colour. */
  .prompt { display: none; }
  a[aria-selected='true'] .prompt { display: inline; }
  a:focus-visible {
    outline: 2px solid var(--magenta);
    outline-offset: 2px;
    text-decoration: underline;
  }

  @media (hover: hover) {
    a:hover { text-decoration: underline; }
  }

  @media (max-width: 899px) {
    /* The tabs sit on a line of their own under the handle and the status pair,
       and they wrap onto a second line rather than shrink. */
    .tab-bar {
      flex-wrap: wrap;
      gap: 0.75rem 1.3125rem;
    }
  }
</style>
