---
import Header from '../components/Header.astro';
import Router from '../components/Router.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { site } from '../data/site.js';
import { buildStructuredData } from '../data/structured-data.js';
import '../styles/global.css';

const {
  title = site.title,
  description = site.description,
  // The 404 document shows the brand row alone. It carries no canonical link,
  // no social tags and no structured data, because it describes no page.
  slim = false,
  discovery = !slim,
  router = !slim,
} = Astro.props;

// Every absolute URL in the head comes from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(site.image, Astro.site).href;
const structuredData = buildStructuredData(Astro.site.origin);
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <ThemeScript />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      discovery && (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content="profile" />
          <meta property="og:site_name" content={site.title} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content={site.imageType} />
          <meta property="og:image:width" content={String(site.imageWidth)} />
          <meta property="og:image:height" content={String(site.imageHeight)} />
          <meta property="og:image:alt" content={site.imageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
          <meta name="twitter:image:alt" content={site.imageAlt} />
          <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header tabs={!slim} status={!slim} />
    <main id="main" tabindex="-1" data-route-ignore>
      <slot />
    </main>
    {router && <Router />}
  </body>
</html>
