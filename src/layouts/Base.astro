---
import Header from '../components/Header.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>@JoeOfSomeTrades</title>
    <meta
      name="description"
      content="Portfolio for @JoeOfSomeTrades. An enthusiast of all things IT, music, audio, and game design and development, with links, certifications, radio, and games."
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      import { initRouter } from '../scripts/router.js';
      initRouter();
    </script>
  </body>
</html>
