{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-29",
  "main": "src/worker.js",
  // The site answers on the custom domain alone. The workers.dev address that
  // was live first, and every version preview URL, are switched off on purpose,
  // so a search engine or a visitor can only ever reach the real site. A routes
  // entry would switch the workers.dev address off by itself, but these stay
  // explicit so a future edit cannot turn either one back on by accident.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "joeofsometrades.com", "custom_domain": true },
    { "pattern": "www.joeofsometrades.com", "custom_domain": true }
  ]
}
